# ---- Required ----
# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# Optional: Neon DIRECT (non-pooled) connection string. Used only by `npm run db:migrate` / `db:seed`.
DIRECT_DATABASE_URL=
# Host dashboard password. Generate one: openssl rand -base64 18
HOST_PASSWORD=
# 32+ random characters used to hash session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=
# Public URL used in QR codes and join links (no trailing slash).
# Local multi-device testing needs your computer's LAN address, e.g. http://192.168.1.20:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional ----
# AI wrong-answer helper. The game works fully without these.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Enables GET /api/cron/cleanup (Bearer token) if you add a scheduled cleanup.
CRON_SECRET=
# "true" shows the "Add demo players" bot button in production. Defaults to on in development.
ENABLE_DEMO_TOOLS=
